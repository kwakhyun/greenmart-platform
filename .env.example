# ============================================================
# GreenMart Platform - 환경 변수 설정
# ============================================================
# 이 파일을 .env 로 복사한 뒤, 실제 값을 입력하세요.
# cp .env.example .env

# ── API 서버 ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── 프론트엔드 (Next.js) ──────────────────────────────────
# 기본값은 같은 Next 앱의 /api/admin 입니다.
# 별도 운영 API를 쓸 때만 설정하세요.
NEXT_PUBLIC_ADMIN_API_URL=

# ── 주문 인입 (선택) ───────────────────────────────────────
# 설정하면 /api/orders 접수 payload를 외부 운영 도구로 전달합니다.
GREENMART_ORDER_WEBHOOK_URL=
