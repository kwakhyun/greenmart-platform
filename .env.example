# ============================================================
# GreenMart Platform - 환경 변수 설정
# ============================================================
# 이 파일을 .env 로 복사한 뒤, 실제 값을 입력하세요.
# cp .env.example .env

# ── 프론트엔드 (Next.js) ──────────────────────────────────
# 브라우저는 기본적으로 같은 Next 앱의 /api 프록시를 호출합니다.
# 외부 API를 브라우저에서 직접 호출할 때만 설정하세요.
NEXT_PUBLIC_ADMIN_API_URL=
# Next.js /api 프록시가 호출할 NestJS API base URL입니다.
# 로컬 개발 기본값은 http://localhost:4000/api 입니다.
GREENMART_API_URL=

# ── API 서버 (NestJS) ─────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ── 주문 인입 (선택) ───────────────────────────────────────
# 설정하면 /api/orders 접수 payload를 외부 운영 도구로 전달합니다.
GREENMART_ORDER_WEBHOOK_URL=
# Vercel Cron이 outbox retry endpoint를 호출할 때 사용하는 Bearer 토큰입니다.
CRON_SECRET=

# ── Postgres ──────────────────────────────────────────────
# NestJS API 서버와 고객 주문 요청 MVP가 사용하는 영속 저장소입니다.
# 로컬 개발 기본값은 docker-compose.yml과 같은 아래 URL입니다.
DATABASE_URL=postgres://greenmart:greenmart@localhost:5432/greenmart
# 운영 배포는 Neon Postgres 연결 문자열을 Vercel 환경변수에 설정합니다.
GREENMART_DATABASE_URL=
GREENMART_TEST_DATABASE_URL=postgres://greenmart:greenmart@localhost:5432/greenmart_test
GREENMART_DB_POOL_MAX=1
